{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/auth/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/houses/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/houses",
      "dest": "main.py"
    },
    {
      "src": "/docs",
      "dest": "main.py"
    },
    {
      "src": "/openapi.json",
      "dest": "main.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*\\.(?:js|css|png|jpg|jpeg|svg|ico|webp|ttf|woff|woff2))$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ]
}
